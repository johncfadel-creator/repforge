// Copier en Config/Secrets.xcconfig puis renseigner (fichier ignoré par git).
// ⚠️ Pas de "https://" : en xcconfig, "//" démarre un commentaire. On ne met que l'hôte.
SUPABASE_HOST = xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY = eyJhbGciOi...

// Team ID Apple (Xcode > Settings > Accounts) — requis pour la signature/installation directe.
DEVELOPMENT_TEAM =
